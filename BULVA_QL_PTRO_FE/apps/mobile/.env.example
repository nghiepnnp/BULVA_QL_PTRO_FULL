EXPO_PUBLIC_DEMO_MODE=true
# Simulator (iOS): http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# iPhone on same Wi-Fi: http://YOUR_MAC_LAN_IP:3000
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Replace these sample URLs/email before release; then set USE_PLACEHOLDER_LINKS=false.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/?document=privacy-policy
EXPO_PUBLIC_TERMS_URL=https://example.com/?document=terms-of-use
EXPO_PUBLIC_SUPPORT_URL=https://example.com/?page=support
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
EXPO_PUBLIC_USE_PLACEHOLDER_LINKS=true

# Social sign-in examples — replace IDs and connect the backend, then enable.
# Keep DEMO_MODE=true and SOCIAL_AUTH_ENABLED=false until configured.
EXPO_PUBLIC_SOCIAL_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_AUTH_PATH=/auth/google
EXPO_PUBLIC_APPLE_AUTH_PATH=/auth/apple
EXPO_PUBLIC_APPLE_CHALLENGE_PATH=/auth/apple/challenge
# Apple native uses ios.bundleIdentifier + usesAppleSignIn in app.json.
# Never put Google client secrets, Apple private keys or Apple client secrets here.
