{
  "name": "@bulva_dev/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "eas": "eas",
    "ota:link": "node scripts/eas-project.cjs link",
    "ota:check": "node scripts/eas-project.cjs check",
    "build:preview": "pnpm ota:check && eas build --profile preview",
    "build:production": "pnpm ota:check && eas build --profile production",
    "ota:preview": "pnpm ota:check && eas update --channel preview --environment preview",
    "ota:production": "pnpm ota:check && eas update --channel production --environment production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@package/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "expo": "~57.0.30",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.16",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
